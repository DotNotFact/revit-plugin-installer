<Page x:Class="RevitPluginInstaller.Views.Pages.SettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:pages="clr-namespace:RevitPluginInstaller.Views.Pages"
      xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
      d:DataContext="{d:DesignInstance pages:SettingPage, IsDesignTimeCreatable=False}"
      mc:Ignorable="d"
      Title="Настройки">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28" MaxWidth="820" HorizontalAlignment="Left">

            <TextBlock Text="{Binding ViewModel.Title}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{Binding ViewModel.Summary}" Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,24" />

            <!-- Revit folder -->
            <Border Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="14" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="FolderCogOutline" Width="18" Height="18" Foreground="{DynamicResource App.Accent}" Margin="0,0,10,0" />
                        <TextBlock Text="Папка Revit" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,16"
                               Text="Корневая папка Revit с подпапкой Addins. Версии определяются по Addins\&lt;год&gt;, туда же копируются плагины; рядом хранятся plugins.json, backups и лог." />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding ViewModel.RevitPath, Mode=OneWay}" IsReadOnly="True" />

                        <Button Grid.Column="1" Command="{Binding ViewModel.SelectFolderCommand}" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Kind="FolderSearchOutline" Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="Обзор…" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border CornerRadius="10" Padding="14,12" Margin="0,14,0,0" Background="{DynamicResource App.SurfaceRaised}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="CheckDecagramOutline" Width="16" Height="16" Foreground="{DynamicResource App.Success}" Margin="0,0,10,0" />
                            <TextBlock Text="Обнаружено: " Style="{StaticResource SecondaryTextStyle}" />
                            <TextBlock Text="{Binding ViewModel.DetectedVersionsText}" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="ThemeLightDark" Width="18" Height="18" Foreground="{DynamicResource App.Accent}" Margin="0,0,10,0" />
                            <TextBlock Text="Тёмная тема" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="Переключение применяется сразу ко всему окну" Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0" />
                    </StackPanel>

                    <CheckBox Grid.Column="1" IsChecked="{Binding ViewModel.IsDarkTheme}" VerticalAlignment="Center" Cursor="Hand">
                        <CheckBox.Template>
                            <ControlTemplate TargetType="CheckBox">
                                <Border x:Name="Track" Width="46" Height="26" CornerRadius="13" Background="{DynamicResource App.SurfaceRaised}" BorderBrush="{DynamicResource App.BorderStrong}" BorderThickness="1">
                                    <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="{DynamicResource App.TextSecondary}" HorizontalAlignment="Left" Margin="3,0,0,0" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Track" Property="Background" Value="{DynamicResource App.AccentGradient}" />
                                        <Setter TargetName="Track" Property="BorderBrush" Value="Transparent" />
                                        <Setter TargetName="Thumb" Property="Fill" Value="#FFFFFF" />
                                        <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </CheckBox.Template>
                    </CheckBox>
                </Grid>
            </Border>

            <!-- Files -->
            <Border Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="FileDocumentOutline" Width="18" Height="18" Foreground="{DynamicResource App.Accent}" Margin="0,0,10,0" />
                        <TextBlock Text="Служебные файлы" FontSize="16" FontWeight="SemiBold" />
                    </StackPanel>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="Реестр плагинов" Style="{StaticResource MutedTextStyle}" Margin="0,0,24,8" />
                        <TextBlock Grid.Column="1" Text="{Binding ViewModel.RegistryPath}" Style="{StaticResource MonoTextStyle}" Foreground="{DynamicResource App.TextSecondary}" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="1" Text="Лог операций" Style="{StaticResource MutedTextStyle}" Margin="0,0,24,8" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ViewModel.LogPath}" Style="{StaticResource MonoTextStyle}" Foreground="{DynamicResource App.TextSecondary}" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="2" Text="Версия приложения" Style="{StaticResource MutedTextStyle}" Margin="0,0,24,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ViewModel.AppVersion}" Style="{StaticResource MonoTextStyle}" Foreground="{DynamicResource App.TextSecondary}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Command="{Binding ViewModel.OpenLogCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Kind="TextBoxOutline" Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="Открыть лог" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ViewModel.OpenRevitFolderCommand}" Margin="10,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" Margin="0,0,8,0" />
                                <TextBlock Text="Открыть папку Revit" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
