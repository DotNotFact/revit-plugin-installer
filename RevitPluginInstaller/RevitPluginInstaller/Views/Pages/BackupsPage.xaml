<Page x:Class="RevitPluginInstaller.Views.Pages.BackupsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:pages="clr-namespace:RevitPluginInstaller.Views.Pages"
      xmlns:core="clr-namespace:RevitPluginInstaller.ViewModels.Core"
      xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
      d:DataContext="{d:DesignInstance pages:BackupsPage, IsDesignTimeCreatable=False}"
      mc:Ignorable="d"
      Title="Бэкапы">

    <Grid Margin="32,28,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding ViewModel.Title}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding ViewModel.Summary}" Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ViewModel.RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="Обновить" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ViewModel.OpenRootCommand}" Margin="10,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="Открыть папку backups" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ViewModel.Backups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:BackupItemViewModel}">
                            <Border Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="48" Height="48" CornerRadius="10" Background="{DynamicResource App.SurfaceRaised}">
                                        <materialIcons:MaterialIcon Kind="ArchiveOutline" Width="22" Height="22" Foreground="{DynamicResource App.TextSecondary}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="18,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource MonoTextStyle}" Margin="0,5,0,0">
                                            <Run Text="{Binding FolderName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SizeText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ItemsText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <Border Grid.Column="2" CornerRadius="9" Padding="14,6" VerticalAlignment="Center" Margin="0,0,20,0"
                                            Background="{DynamicResource App.WarningSoft}" BorderBrush="{DynamicResource App.Warning}" BorderThickness="1">
                                        <TextBlock Text="{Binding CountText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource App.Warning}" />
                                    </Border>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="Открыть папку бэкапа"
                                                Command="{Binding DataContext.ViewModel.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}">
                                            <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" />
                                        </Button>
                                        <Button Style="{StaticResource DangerIconButtonStyle}" ToolTip="Удалить бэкап" Margin="8,0,0,0"
                                                Command="{Binding DataContext.ViewModel.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}">
                                            <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding ViewModel.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" HorizontalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="History" Width="28" Height="28" Foreground="{DynamicResource App.TextMuted}" />
                </Border>
                <TextBlock Text="Бэкапов пока нет" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6" />
                <TextBlock Text="Они появятся при замене или удалении плагина" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
