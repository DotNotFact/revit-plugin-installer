<Page x:Class="RevitPluginInstaller.Views.Pages.DownloadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:pages="clr-namespace:RevitPluginInstaller.Views.Pages"
      xmlns:core="clr-namespace:RevitPluginInstaller.ViewModels.Core"
      xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
      d:DataContext="{d:DesignInstance pages:DownloadPage, IsDesignTimeCreatable=False}"
      mc:Ignorable="d"
      Title="Установленные плагины">

    <Grid Margin="32,28,32,20" AllowDrop="True" Drop="OnDrop" PreviewDragOver="OnPreviewDragOver">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding ViewModel.Title}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding ViewModel.Summary}" Style="{StaticResource SecondaryTextStyle}" Margin="14,6,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ViewModel.RefreshCommand}" ToolTip="Перечитать список">
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Text="Обновить" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ViewModel.ExportCommand}" Margin="10,0,0,0" ToolTip="Сохранить список плагинов в JSON">
                    <TextBlock Text="Экспорт JSON" />
                </Button>
                <Button Style="{StaticResource DangerIconButtonStyle}" Width="40" Height="40" Command="{Binding ViewModel.RemoveAllCommand}" Margin="10,0,0,0" ToolTip="Удалить все плагины (с бэкапом)">
                    <materialIcons:MaterialIcon Kind="DeleteSweepOutline" Width="18" Height="18" />
                </Button>
                <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ViewModel.InstallCommand}" Margin="10,0,0,0" ToolTip="Установить файлы из очереди или выбрать их">
                    <TextBlock Text="{Binding ViewModel.InstallButtonText}" Foreground="#FFFFFF" FontWeight="SemiBold" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Drop zone -->
        <Button Grid.Row="1" Command="{Binding ViewModel.BrowseCommand}" Height="64" Margin="0,0,0,20" Cursor="Hand"
                Background="Transparent" BorderThickness="0" Padding="0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Zone" CornerRadius="12" Background="{DynamicResource App.Surface}">
                        <Grid>
                            <Rectangle RadiusX="12" RadiusY="12" Stroke="{DynamicResource App.BorderStrong}" StrokeThickness="1.5" StrokeDashArray="5 4" />
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource App.TextSecondary}" FontSize="14" TextTrimming="None">
                                <Run Text="Перетащите сюда " /><Run Text=".dll / .addin" Foreground="{DynamicResource App.Accent}" FontWeight="SemiBold" /><Run Text=" файлы или папку плагина — установка с автоматическим бэкапом" />
                            </TextBlock>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Zone" Property="Background" Value="{DynamicResource App.SurfaceHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <!-- Plugin list -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ViewModel.Plugins}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:PluginItemViewModel}">
                            <Border x:Name="Row" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Width="48" Height="48" CornerRadius="10" Background="{DynamicResource App.SurfaceRaised}">
                                        <materialIcons:MaterialIcon Kind="{Binding Icon}" Width="22" Height="22" Foreground="{DynamicResource App.TextSecondary}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="18,0,16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Meta}" Style="{StaticResource MonoTextStyle}" Margin="0,5,0,0" />
                                    </StackPanel>

                                    <Border x:Name="Status" Grid.Column="2" CornerRadius="9" Padding="14,6" VerticalAlignment="Center" Margin="0,0,20,0"
                                            Background="{DynamicResource App.SuccessSoft}" BorderBrush="{DynamicResource App.Success}" BorderThickness="1">
                                        <TextBlock x:Name="StatusText" Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource App.Success}" />
                                    </Border>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="Создать бэкап"
                                                Command="{Binding DataContext.ViewModel.BackupCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}">
                                            <materialIcons:MaterialIcon Kind="History" Width="16" Height="16" />
                                        </Button>
                                        <Button Style="{StaticResource IconButtonStyle}" ToolTip="Показать в проводнике" Margin="8,0,0,0"
                                                Command="{Binding DataContext.ViewModel.OpenLocationCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}">
                                            <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="16" Height="16" />
                                        </Button>
                                        <Button Style="{StaticResource DangerIconButtonStyle}" ToolTip="Удалить (с бэкапом)" Margin="8,0,0,0"
                                                Command="{Binding DataContext.ViewModel.RemoveCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}">
                                            <materialIcons:MaterialIcon Kind="TrashCanOutline" Width="16" Height="16" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                    <Setter TargetName="Status" Property="Background" Value="{DynamicResource App.WarningSoft}" />
                                    <Setter TargetName="Status" Property="BorderBrush" Value="{DynamicResource App.Warning}" />
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource App.Warning}" />
                                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource App.AccentBorder}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="Missing">
                                    <Setter TargetName="Status" Property="Background" Value="{DynamicResource App.DangerSoft}" />
                                    <Setter TargetName="Status" Property="BorderBrush" Value="{DynamicResource App.Danger}" />
                                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource App.Danger}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding ViewModel.IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" HorizontalAlignment="Center">
                    <materialIcons:MaterialIcon Kind="PackageVariant" Width="28" Height="28" Foreground="{DynamicResource App.TextMuted}" />
                </Border>
                <TextBlock Text="Плагинов пока нет" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6" />
                <TextBlock Text="Перетащите файлы в область выше или нажмите «Установить»" Style="{StaticResource MutedTextStyle}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="12" Padding="18,0" Height="48" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding ViewModel.StatusText}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" MaxWidth="520" />

                <ProgressBar Grid.Column="1" Value="{Binding ViewModel.InstallationProgress}" Maximum="100" Margin="16,0" VerticalAlignment="Center"
                             Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />

                <TextBlock Grid.Column="2" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" MinWidth="36" TextAlignment="Right"
                           Visibility="{Binding ViewModel.IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Run Text="{Binding ViewModel.InstallationProgress, Mode=OneWay}" /><Run Text="%" />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Page>
