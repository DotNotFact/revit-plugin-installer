<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:RevitPluginInstaller.Managers.Bases.Theme"
    xmlns:converters="clr-namespace:RevitPluginInstaller.Converters">

    <Style x:Key="DefaultWindowStyle" TargetType="{x:Type Window}">

        <Setter Property="Background" Value="{DynamicResource App.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource App.Text}" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Arial" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="14" />

        <Setter Property="Height" Value="820" />
        <Setter Property="Width" Value="1280" />
        <Setter Property="MinHeight" Value="640" />
        <Setter Property="MinWidth" Value="980" />

        <Setter Property="MaxHeight" Value="{Binding Source={x:Static SystemParameters.MaximizedPrimaryScreenHeight}}" />
        <Setter Property="MaxWidth" Value="{Binding Source={x:Static SystemParameters.MaximizedPrimaryScreenWidth}}" />

        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderBrush" Value="{DynamicResource App.Border}" />
        <Setter Property="BorderThickness" Value="1" />

        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        <Setter Property="RenderOptions.ClearTypeHint" Value="Enabled" />

        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Window}">
                    <AdornerDecorator>
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <Border.Clip>
                                <MultiBinding>
                                    <MultiBinding.Converter>
                                        <converters:RoundedClipConverter Radius="12" />
                                    </MultiBinding.Converter>
                                    <Binding ElementName="Chrome" Path="ActualWidth" />
                                    <Binding ElementName="Chrome" Path="ActualHeight" />
                                </MultiBinding>
                            </Border.Clip>
                            <ContentPresenter x:Name="ContentPresenter" />
                        </Border>
                    </AdornerDecorator>
                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="Chrome" Property="CornerRadius" Value="0" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="0" />
                            <Setter TargetName="Chrome" Property="Clip" Value="{x:Null}" />
                            <Setter TargetName="Chrome" Property="Margin" Value="7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <Style TargetType="{x:Type Window}" BasedOn="{StaticResource DefaultWindowStyle}" />
    <Style TargetType="{x:Type local:WindowThemeBase}" BasedOn="{StaticResource DefaultWindowStyle}" />

</ResourceDictionary>
