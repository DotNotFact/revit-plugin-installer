<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ApplicationIcon>wwwroot\Images\Logo.ico</ApplicationIcon>
		<Version>2.0.0</Version>
		<AssemblyTitle>Revit Plugin Manager</AssemblyTitle>
		<Product>Revit Plugin Manager</Product>
	</PropertyGroup>

	<ItemGroup>
	  <Resource Include="wwwroot\Images\Logo.ico">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </Resource>
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="Material.Icons.WPF" Version="3.0.2" />
	  <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
	  <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

</Project>
