<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Semantic palette -->
    <Color x:Key="App.BackgroundColor">#15171C</Color>
    <Color x:Key="App.SidebarColor">#191C22</Color>
    <Color x:Key="App.SurfaceColor">#1D2027</Color>
    <Color x:Key="App.SurfaceHoverColor">#23272F</Color>
    <Color x:Key="App.SurfaceRaisedColor">#262A33</Color>
    <Color x:Key="App.BorderColor">#2A2E37</Color>
    <Color x:Key="App.BorderStrongColor">#3B404C</Color>
    <Color x:Key="App.TextColor">#F2F3F5</Color>
    <Color x:Key="App.TextSecondaryColor">#A9AEBA</Color>
    <Color x:Key="App.TextMutedColor">#6E7482</Color>

    <Color x:Key="App.AccentColor">#FF6A3D</Color>
    <Color x:Key="App.AccentHoverColor">#FF7F58</Color>
    <Color x:Key="App.AccentSoftColor">#3A2319</Color>
    <Color x:Key="App.AccentBorderColor">#5A3222</Color>

    <Color x:Key="App.SuccessColor">#3DD68C</Color>
    <Color x:Key="App.SuccessSoftColor">#173127</Color>
    <Color x:Key="App.WarningColor">#F5B942</Color>
    <Color x:Key="App.WarningSoftColor">#342A15</Color>
    <Color x:Key="App.DangerColor">#FF5F5F</Color>
    <Color x:Key="App.DangerSoftColor">#3A1E1E</Color>

    <SolidColorBrush x:Key="App.Background" Color="{StaticResource App.BackgroundColor}" />
    <SolidColorBrush x:Key="App.Sidebar" Color="{StaticResource App.SidebarColor}" />
    <SolidColorBrush x:Key="App.Surface" Color="{StaticResource App.SurfaceColor}" />
    <SolidColorBrush x:Key="App.SurfaceHover" Color="{StaticResource App.SurfaceHoverColor}" />
    <SolidColorBrush x:Key="App.SurfaceRaised" Color="{StaticResource App.SurfaceRaisedColor}" />
    <SolidColorBrush x:Key="App.Border" Color="{StaticResource App.BorderColor}" />
    <SolidColorBrush x:Key="App.BorderStrong" Color="{StaticResource App.BorderStrongColor}" />
    <SolidColorBrush x:Key="App.Text" Color="{StaticResource App.TextColor}" />
    <SolidColorBrush x:Key="App.TextSecondary" Color="{StaticResource App.TextSecondaryColor}" />
    <SolidColorBrush x:Key="App.TextMuted" Color="{StaticResource App.TextMutedColor}" />

    <SolidColorBrush x:Key="App.Accent" Color="{StaticResource App.AccentColor}" />
    <SolidColorBrush x:Key="App.AccentHover" Color="{StaticResource App.AccentHoverColor}" />
    <SolidColorBrush x:Key="App.AccentSoft" Color="{StaticResource App.AccentSoftColor}" />
    <SolidColorBrush x:Key="App.AccentBorder" Color="{StaticResource App.AccentBorderColor}" />

    <LinearGradientBrush x:Key="App.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF7A3D" Offset="0" />
        <GradientStop Color="#FF4D6D" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="App.ProgressGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF7A3D" Offset="0" />
        <GradientStop Color="#FF4D6D" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="App.Success" Color="{StaticResource App.SuccessColor}" />
    <SolidColorBrush x:Key="App.SuccessSoft" Color="{StaticResource App.SuccessSoftColor}" />
    <SolidColorBrush x:Key="App.Warning" Color="{StaticResource App.WarningColor}" />
    <SolidColorBrush x:Key="App.WarningSoft" Color="{StaticResource App.WarningSoftColor}" />
    <SolidColorBrush x:Key="App.Danger" Color="{StaticResource App.DangerColor}" />
    <SolidColorBrush x:Key="App.DangerSoft" Color="{StaticResource App.DangerSoftColor}" />

    <!-- Legacy keys kept for older styles -->
    <Color x:Key="ApplicationBackgroundDefault">#15171C</Color>
    <Color x:Key="ApplicationForegroundDefault">#F2F3F5</Color>
    <Color x:Key="ApplicationForegroundDefault100">#F2F3F5</Color>
    <Color x:Key="ApplicationBackgroundDefault100">#15171C</Color>
    <Color x:Key="ApplicationBackgroundDefault200">#1D2027</Color>
    <Color x:Key="ApplicationBackgroundDefault300">#262A33</Color>
    <Color x:Key="ApplicationBackgroundDefault400">#2F343E</Color>
    <Color x:Key="ApplicationBackgroundDefault500">#3B404C</Color>
    <Color x:Key="ApplicationBackgroundDefault600">#4A5060</Color>

    <SolidColorBrush x:Key="ApplicationBackgroundDefaultBrush" Color="{StaticResource ApplicationBackgroundDefault}" />
    <SolidColorBrush x:Key="ApplicationForegroundDefaultBrush" Color="{StaticResource ApplicationForegroundDefault}" />
    <SolidColorBrush x:Key="ApplicationForegroundDefault100Brush" Color="{StaticResource ApplicationForegroundDefault100}" />
    <SolidColorBrush x:Key="ApplicationBackgroundDefault100Brush" Color="{StaticResource ApplicationBackgroundDefault100}" />
    <SolidColorBrush x:Key="ApplicationBackgroundDefault200Brush" Color="{StaticResource ApplicationBackgroundDefault200}" />
    <SolidColorBrush x:Key="ApplicationBackgroundDefault300Brush" Color="{StaticResource ApplicationBackgroundDefault300}" />
    <SolidColorBrush x:Key="ApplicationBackgroundDefault400Brush" Color="{StaticResource ApplicationBackgroundDefault400}" />
    <SolidColorBrush x:Key="ApplicationBackgroundDefault500Brush" Color="{StaticResource ApplicationBackgroundDefault500}" />
    <SolidColorBrush x:Key="ApplicationBackgroundDefault600Brush" Color="{StaticResource ApplicationBackgroundDefault600}" />

</ResourceDictionary>
