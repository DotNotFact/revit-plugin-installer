<Page x:Class="RevitPluginInstaller.Views.Pages.TransferPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:pages="clr-namespace:RevitPluginInstaller.Views.Pages"
      xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
      d:DataContext="{d:DesignInstance pages:TransferPage, IsDesignTimeCreatable=False}"
      mc:Ignorable="d"
      Title="Экспорт / импорт">

    <Grid Margin="32,28,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="{Binding ViewModel.Title}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{Binding ViewModel.Summary}" Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="None" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Export card -->
            <Border Grid.Column="0" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="14" Padding="24">
                <StackPanel>
                    <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource App.AccentSoft}" HorizontalAlignment="Left">
                        <materialIcons:MaterialIcon Kind="TrayArrowUp" Width="22" Height="22" Foreground="{DynamicResource App.Accent}" />
                    </Border>
                    <TextBlock Text="Экспорт в JSON" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,6" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" TextTrimming="None"
                               Text="Сохраняет реестр установленных плагинов: версии Revit, пути и даты установки. Файлы плагинов в архив не входят." />

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Border CornerRadius="10" Padding="14,10" Background="{DynamicResource App.SurfaceRaised}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding ViewModel.PluginCount}" FontSize="20" FontWeight="Bold" />
                                <TextBlock Text="ПЛАГИНОВ" Style="{StaticResource MutedTextStyle}" FontSize="10" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="10" Padding="14,10" Margin="10,0,0,0" Background="{DynamicResource App.SurfaceRaised}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding ViewModel.VersionCount}" FontSize="20" FontWeight="Bold" />
                                <TextBlock Text="ВЕРСИЙ REVIT" Style="{StaticResource MutedTextStyle}" FontSize="10" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ViewModel.ExportCommand}" HorizontalAlignment="Left" Margin="0,22,0,0">
                        <TextBlock Text="Экспортировать" Foreground="#FFFFFF" FontWeight="SemiBold" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- Import card -->
            <Border Grid.Column="2" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="14" Padding="24">
                <StackPanel>
                    <Border Width="48" Height="48" CornerRadius="12" Background="{DynamicResource App.SurfaceRaised}" HorizontalAlignment="Left">
                        <materialIcons:MaterialIcon Kind="TrayArrowDown" Width="22" Height="22" Foreground="{DynamicResource App.TextSecondary}" />
                    </Border>
                    <TextBlock Text="Импорт из JSON" FontSize="18" FontWeight="SemiBold" Margin="0,18,0,6" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" TextTrimming="None"
                               Text="Восстанавливает реестр из ранее экспортированного файла. Текущие записи будут заменены - перед импортом стоит сделать экспорт." />

                    <Border CornerRadius="10" Padding="14,12" Margin="0,18,0,0" Background="{DynamicResource App.WarningSoft}" BorderBrush="{DynamicResource App.Warning}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <materialIcons:MaterialIcon Kind="AlertOutline" Width="16" Height="16" Foreground="{DynamicResource App.Warning}" Margin="0,0,8,0" />
                            <TextBlock Text="Импорт не копирует файлы плагинов, только их список" FontSize="12" Foreground="{DynamicResource App.Warning}" TextWrapping="Wrap" TextTrimming="None" />
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding ViewModel.ImportCommand}" HorizontalAlignment="Left" Margin="0,22,0,0">
                        <TextBlock Text="Выбрать файл…" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="12" Padding="18,0" Height="48" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <materialIcons:MaterialIcon Kind="InformationOutline" Width="16" Height="16" Foreground="{DynamicResource App.TextMuted}" Margin="0,0,10,0" />
                <TextBlock Text="{Binding ViewModel.LastAction}" Style="{StaticResource SecondaryTextStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
