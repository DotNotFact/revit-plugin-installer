<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:RevitPluginInstaller.Converters">

    <converters:EqualsConverter x:Key="EqualsConverter" />
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <converters:BoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" Invert="True" />
    <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
    <converters:CountToVisibilityConverter x:Key="ZeroCountToVisibilityConverter" Invert="True" />

</ResourceDictionary>
