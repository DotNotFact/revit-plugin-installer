<local:WindowThemeBase
    xmlns:local="clr-namespace:RevitPluginInstaller.Managers.Bases.Theme"
    x:Class="RevitPluginInstaller.Views.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windows="clr-namespace:RevitPluginInstaller.Views.Windows"
    xmlns:core="clr-namespace:RevitPluginInstaller.ViewModels.Core"
    xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
    mc:Ignorable="d"
    Title="Revit Plugin Manager"
    Width="1280"
    Height="820"
    WindowStyle="None"
    ResizeMode="CanResize"
    AllowsTransparency="True"
    Background="Transparent"
    WindowStartupLocation="CenterScreen"
    d:DataContext="{d:DesignInstance windows:MainWindow, IsDesignTimeCreatable=False}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52" CornerRadius="12" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Grid.Row="0" Background="{DynamicResource App.Sidebar}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource App.AccentGradient}">
                    <materialIcons:MaterialIcon Kind="PuzzleOutline" Width="16" Height="16" Foreground="#FFFFFF" />
                </Border>
                <TextBlock Text="{Binding ViewModel.Title}" FontSize="15" FontWeight="Bold" Margin="12,0,0,0" />
                <TextBlock Text="{Binding ViewModel.Subtitle}" Style="{StaticResource MutedTextStyle}" FontSize="12" Margin="12,1,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButtonStyle}" Command="{Binding ViewModel.MinimizeCommand}" ToolTip="Свернуть">
                    <materialIcons:MaterialIcon Kind="WindowMinimize" Width="14" Height="14" />
                </Button>
                <Button Style="{StaticResource CaptionButtonStyle}" Command="{Binding ViewModel.MaximizeCommand}" ToolTip="Развернуть">
                    <materialIcons:MaterialIcon Kind="WindowMaximize" Width="14" Height="14" />
                </Button>
                <Button Style="{StaticResource CaptionCloseButtonStyle}" Command="{Binding ViewModel.CloseApplicationCommand}" ToolTip="Закрыть">
                    <materialIcons:MaterialIcon Kind="WindowClose" Width="14" Height="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource App.Sidebar}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14,24,14,16">

                        <TextBlock Text="ВЕРСИИ REVIT" Style="{StaticResource SectionLabelStyle}" />

                        <ItemsControl ItemsSource="{Binding ViewModel.Versions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type core:RevitVersionItemViewModel}">
                                    <RadioButton Style="{StaticResource NavItemStyle}"
                                                 GroupName="RevitVersions"
                                                 IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                 Command="{Binding DataContext.ViewModel.SelectVersionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 CommandParameter="{Binding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Ellipse Width="8" Height="8" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource App.TextMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasPlugins}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource App.Success}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" FontWeight="SemiBold" FontSize="14" />

                                            <Border Grid.Column="2" CornerRadius="8" Padding="8,3" Background="{DynamicResource App.SurfaceRaised}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1">
                                                <TextBlock Text="{Binding CountText}" FontSize="12" Foreground="{DynamicResource App.TextSecondary}" />
                                            </Border>
                                        </Grid>
                                    </RadioButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Visibility="{Binding ViewModel.HasVersions, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,2,0,0">
                            <TextBlock Text="Версии не найдены. Укажите папку Revit в настройках." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" TextTrimming="None" />
                        </Border>

                        <TextBlock Text="РАЗДЕЛЫ" Style="{StaticResource SectionLabelStyle}" Margin="14,28,0,8" />

                        <RadioButton Style="{StaticResource NavItemStyle}" GroupName="Sections"
                                     IsChecked="{Binding ViewModel.ActiveSection, Converter={StaticResource EqualsConverter}, ConverterParameter=Installed, Mode=OneWay}"
                                     Command="{Binding ViewModel.NavigateSectionCommand}" CommandParameter="Installed">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Kind="PackageVariantClosed" Width="18" Height="18" Margin="0,0,10,0" />
                                <TextBlock Text="Установленные" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavItemStyle}" GroupName="Sections"
                                     IsChecked="{Binding ViewModel.ActiveSection, Converter={StaticResource EqualsConverter}, ConverterParameter=Backups, Mode=OneWay}"
                                     Command="{Binding ViewModel.NavigateSectionCommand}" CommandParameter="Backups">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Kind="History" Width="18" Height="18" Margin="0,0,10,0" />
                                <TextBlock Text="Бэкапы" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavItemStyle}" GroupName="Sections"
                                     IsChecked="{Binding ViewModel.ActiveSection, Converter={StaticResource EqualsConverter}, ConverterParameter=Transfer, Mode=OneWay}"
                                     Command="{Binding ViewModel.NavigateSectionCommand}" CommandParameter="Transfer">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Kind="SwapVertical" Width="18" Height="18" Margin="0,0,10,0" />
                                <TextBlock Text="Экспорт / импорт" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Style="{StaticResource NavItemStyle}" GroupName="Sections"
                                     IsChecked="{Binding ViewModel.ActiveSection, Converter={StaticResource EqualsConverter}, ConverterParameter=Settings, Mode=OneWay}"
                                     Command="{Binding ViewModel.NavigateSectionCommand}" CommandParameter="Settings">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Kind="CogOutline" Width="18" Height="18" Margin="0,0,10,0" />
                                <TextBlock Text="Настройки" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                            </StackPanel>
                        </RadioButton>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Content -->
            <Border Grid.Column="1" Background="{DynamicResource App.Background}" BorderBrush="{DynamicResource App.Border}" BorderThickness="0,1,0,0">
                <Frame x:Name="MainFrame" x:FieldModifier="public" NavigationUIVisibility="Hidden" Focusable="False" />
            </Border>
        </Grid>
    </Grid>
</local:WindowThemeBase>
